# OpenRouter — unified gateway to many LLMs (free tier covers this demo)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used by the tailoring agent. Free tier options known to support
# tool calling well via OpenAI-compatible API:
#   - google/gemini-2.0-flash-exp:free            (recommended — fast, vision-capable)
#   - meta-llama/llama-3.3-70b-instruct:free      (heavier, slower, sometimes hits limits)
#   - qwen/qwen-2.5-72b-instruct:free             (strong tool calling)
AGENT_MODEL=google/gemini-2.0-flash-exp:free

# Model used as judge in the eval harness. Same as AGENT_MODEL is fine.
JUDGE_MODEL=google/gemini-2.0-flash-exp:free

# Local embedding model from HuggingFace (downloaded on first run, cached).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# SQLite DB path (override for tests).
DATABASE_URL=sqlite:///data/mypdfcv_ai.db

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
