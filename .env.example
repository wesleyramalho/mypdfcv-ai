# OpenRouter — unified gateway to many LLMs (free tier covers this demo)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used by the tailoring agent. Free-tier OpenRouter options known to
# support tool calling reliably (as of 2026-05):
#   - meta-llama/llama-3.3-70b-instruct:free    (recommended — battle-tested with tools)
#   - openai/gpt-oss-120b:free                   (OpenAI open weights, strong tool calling)
#   - qwen/qwen3-next-80b-a3b-instruct:free     (also strong, slightly faster)
# Bring your own paid model by switching to e.g. anthropic/claude-sonnet-4.5
# and adding OPENROUTER credits — no code changes needed.
AGENT_MODEL=openai/gpt-oss-120b:free

# Comma-separated fallback chain. The LLM client retries with the next
# model on upstream rate limits or transient errors. This is the
# "graceful failure mechanism" the JD asks for.
AGENT_FALLBACK_MODELS=qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free

# Model used as judge in the eval harness. Same as AGENT_MODEL is fine.
JUDGE_MODEL=openai/gpt-oss-120b:free

# Local embedding model from HuggingFace (downloaded on first run, cached).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# SQLite DB path (override for tests).
DATABASE_URL=sqlite:///data/mypdfcv_ai.db

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
